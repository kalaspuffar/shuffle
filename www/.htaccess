# Shuffle — asset cache policy
#
# JS/CSS are versioned only by Last-Modified/ETag. Without an explicit
# Cache-Control, browsers may heuristically cache board.js/app.js for a long
# time, so deploys silently serve stale code (symptom: "new feature doesn't
# open" until a hard reload). "no-cache" = revalidate on every request:
# still fast (304 when unchanged) but always correct.
#
# Only affects requests under this DocumentRoot (www/).

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, no-cache, must-revalidate"
    </FilesMatch>

    # X-Frame-Options: the app itself sends `X-Frame-Options: DENY` from
    # every PHP entry point (spec section 6.9: no frames anywhere). Some
    # deployments ALSO set X-Frame-Options in the Apache vhost (e.g.
    # "SAMEORIGIN"), which produces a response with two conflicting values —
    # Chrome then refuses to display the site in a frame at all ("Falling
    # back to 'deny'"). `Header always set` at the server level replaces the
    # per-response headers instead of appending, which collapses the pair
    # into a single `DENY` and also documents the app's actual intent
    # (no framing; the CSP already carries `frame-ancestors 'none'`).
    # If you change the vhost's value, keep it consistent with this one.
    Header always set X-Frame-Options "DENY"
</IfModule>
